# Build environments and artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/

_*
\.*
# `_*` wrongly matches the package marker files, so exempt them (historically every __init__.py had to be force-added with git add -f)
!__init__.py

Secret
*[Ss][Ee][Cc][Rr][Ee][Tt]*

Private
*[Pp][Rr][Ii][Vv][Aa][Tt][Ee]*

Obsolete
*[Oo][Bb][Ss][Oo][Ll][Ee][Tt][Ee]*

Temp
*[Tt][Ee][Mm][Pp]*
# Names containing "Template" are not temporary files: re-include them (must stay after the Temp pattern; cannot rescue a path whose parent directory is itself excluded)
!*[Tt][Ee][Mm][Pp][Ll][Aa][Tt][Ee]*

TODO
*[Tt][Oo][Dd][Oo]*

# Test files: not reviewed as strictly as production code and their fixtures may leak private data, so excluded by default (force-add a wrongly matched file with git add -f)
*[Tt][Ee][Ss][Tt]*

src/Chem_Lib/Executable_*
src/LLM_Lib/qdrant.exe
Predownloaded_Weights/
src_Saves
Config.json

# Converted copies of third-party copyrighted manuals (Gaussian, Multiwfn, ORCA, xTB) — for
# local RAG only, keep out of the public repo. The Manual_*_README.md pointer files are tracked.
/src/Chem_Lib/Manual_*_Full.md
/src/Chem_Lib/Manual_*_README.md
/Manuals/

# The shared copy of the Raysync command-line client (rayfile-c.exe + private DLLs) is Raysync's proprietary
# commercial software and must not enter the public repository. Only its provenance note README.md is tracked.
src/HPC_Lib/Raysync_Client/*
!src/HPC_Lib/Raysync_Client/README.md

# The project's collaboration rules document serves only the local Claude sessions and does not enter the public repository
/CLAUDE.md

# Claude's exploratory script folder (including archived user-provided screenshots)
_Claude_tmp/

# Runtime data (such as the channel health records of literature-retrieval) is not committed
_Runtime_Data/

# ==== Missing standard entries added (standard template of Initialize_Project_Gitignore.py) ====

# Python
*.py[cod]
venv/

# Lint and test caches
htmlcov/

# Node
node_modules/

# Logs
*.log
logs/

# Office lock files and backup / temporary suffixes
~$*
*.bak
*.tmp
*.swp
*~

# System files
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db
